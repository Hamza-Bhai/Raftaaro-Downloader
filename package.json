{
  "name": "raftaaro",
  "version": "1.0.0",
  "description": "Raftaaro — a free, open source download manager with multi-connection downloads and YouTube/video support",
  "main": "./out/main/index.js",
  "author": "Hamza Pervaiz",
  "license": "MIT",
  "homepage": "https://github.com/Hamza-Bhai/Raftaaro-Downloader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hamza-Bhai/Raftaaro-Downloader.git"
  },
  "bugs": {
    "url": "https://github.com/Hamza-Bhai/Raftaaro-Downloader/issues"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps && node scripts/fetch-bins.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "test": "vitest run",
    "fetch-bins": "node scripts/fetch-bins.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "productName": "Raftaaro"
}
